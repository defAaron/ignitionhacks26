{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://baio.app/schemas/detection-shapes.json",
  "title": "baio vision output — shape detection set",
  "description": "Output of the vision layer after the shapes-first pivot. Kinds are GEOMETRIC (what the ink looks like); ops in shapes-v1.json are SEMANTIC (what to make) — the builder maps kind + glyph + context to an op. bbox is advisory only: the normalizer overwrites it with the claimed strokes' real bounds. See shared/schemas/README.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["detections"],
  "properties": {
    "detections": {
      "type": "array",
      "items": { "$ref": "#/definitions/detection" }
    }
  },
  "definitions": {
    "detection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stroke_ids",
        "kind",
        "glyph",
        "text",
        "colors",
        "gradient_direction",
        "confidence",
        "bbox"
      ],
      "properties": {
        "stroke_ids": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "kind": {
          "enum": [
            "rect",
            "ellipse",
            "line",
            "arrow",
            "scribble",
            "smooth_path",
            "text_writing"
          ]
        },
        "glyph": {
          "type": ["string", "null"]
        },
        "text": {
          "type": ["string", "null"]
        },
        "colors": {
          "type": "array",
          "items": { "type": "string" }
        },
        "gradient_direction": {
          "enum": ["down", "right", "diagonal", null]
        },
        "composite": {
          "description": "Diagram-shaped cluster hint (wave 1.5): which diagram the whole cluster LOOKS like, or null. Advisory, like a glyph for diagrams — the geometric recognizer prefers its own stroke measurements; this rescues messy ink.",
          "enum": [
            "bar_chart",
            "pie_chart",
            "venn_diagram",
            "timeline",
            "periodic_table",
            "atomic_structure",
            null
          ]
        },
        "confidence": { "type": "number" },
        "bbox": { "$ref": "#/definitions/bbox" }
      }
    },
    "bbox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": "number" },
        "height": { "type": "number" }
      }
    }
  }
}
