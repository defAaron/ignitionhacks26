# baio environment — copy to .env and fill in. All vars optional unless noted.

# --- Vision + baseline builder (Gemini) ---
GEMINI_API_KEY=            # REQUIRED for /api/autocomplete (vision + prompted baseline)
GEMINI_MODEL=              # vision model override (default: gemini-2.5-flash-lite)
GEMINI_BUILDER_MODEL=      # baseline-builder model override (default: gemini-2.5-flash-lite)

# --- FreeSolo adapter (trained builder, OpenAI-compatible) ---
FREESOLO_BASE_URL=         # from `flash deployments --json` → openai_base_url
FREESOLO_API_KEY=
FREESOLO_MODEL=            # deployed run id

# --- Pipeline switches ---
BUILDER=                   # "baseline" | "freesolo" (default: baseline)
SCHEMA_CONTRACT=           # "shapes" | "legacy" (default: shapes)

# --- Frame (Claude) ---
ANTHROPIC_API_KEY=         # REQUIRED for /api/frame (Frame → real website)
FRAME_MODEL=               # frame model override (default: claude-sonnet-5)

# --- Debug ---
DEBUG_PNG_DIR=             # dump pipeline input PNGs here
DEBUG_PNG_PATH=
