# baio environment — copy to .env and fill in, then restart `npm run dev`.
# On Vercel: Project → Settings → Environment Variables (same names, all scopes).
#
# For a working demo you need exactly two keys:
#   GEMINI_API_KEY      turns ink into elements (press Enter)   https://aistudio.google.com/apikey
#   ANTHROPIC_API_KEY   Seal: builds the real website           https://console.anthropic.com/
# Everything else is optional. Without keys you can still draw, import a
# website and turn it into elements; the studio tells you what's missing.

# --- Vision + baseline builder (Gemini) ---
GEMINI_API_KEY=            # REQUIRED for /api/autocomplete (vision + prompted baseline)
GEMINI_MODEL=              # vision model override (default: gemini-2.5-flash-lite)
GEMINI_BUILDER_MODEL=      # baseline-builder model override (default: gemini-2.5-flash-lite)

# --- FreeSolo adapter (trained builder, OpenAI-compatible) ---
FREESOLO_BASE_URL=         # from `flash deployments --json` → openai_base_url
FREESOLO_API_KEY=
FREESOLO_MODEL=            # deployed run id

# --- Pipeline switches ---
BUILDER=                   # "baseline" | "freesolo" (default: baseline)
SCHEMA_CONTRACT=           # "shapes" | "legacy" (default: shapes)

# --- Frame (Claude) ---
ANTHROPIC_API_KEY=         # REQUIRED for /api/frame (Frame → real website)
FRAME_MODEL=               # frame model override (default: claude-sonnet-5)

# --- Modules ---
NEXT_PUBLIC_MODULE_EXISTING_SITE=   # "1" enables Import site (sketch edits onto an existing website)

# --- Debug ---
DEBUG_PNG_DIR=             # dump pipeline input PNGs here
DEBUG_PNG_PATH=
